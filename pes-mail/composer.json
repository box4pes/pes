{
    "name": "pes/pes-mail",
    "type": "library",
    "description": "Mail sending layer for Pes (PHPMailer wrapper, assembly, SMTP configuration).",
    "license": "MIT",
    "keywords": [
        "pes",
        "framework",
        "mail",
        "phpmailer"
    ],
    "authors": [
        {
            "name": "Petr Svoboda",
            "email": "pesbox@email.cz"
        }
    ],
