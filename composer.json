{
    "name": "pes/pes",
    "type": "library",
    "description": "Psí framework pro PHP 8.4.",
    "license": "MIT",
    "keywords": ["pes", "framework"],
    "authors": [
        {
            "name": "Petr Svoboda",
            "email": "svoboda@grafia.cz"
        }
    ],
    "version": "8.27.01",
    "repositories": [
        {
            "type": "path",
            "url": "pes-session",
            "options": { "symlink": true }
        },
        {
            "type": "path",
            "url": "pes-http",
            "options": { "symlink": true }
        },
        {
            "type": "path",
            "url": "pes-di",
            "options": { "symlink": true }
        },
        {
            "type": "path",
            "url": "pes-core",
            "options": { "symlink": true }
        },
        {
            "type": "path",
            "url": "pes-router",
            "options": { "symlink": true }
        },
        {
            "type": "path",
            "url": "pes-database",
            "options": { "symlink": true }
        },
        {
            "type": "path",
            "url": "pes-view",
            "options": { "symlink": true }
        },
        {
            "type": "path",
            "url": "pes-application",
            "options": { "symlink": true }
        },
        {
            "type": "path",
            "url": "pes-logger",
            "options": { "symlink": true }
        },
        {
            "type": "path",
            "url": "pes-bootstrap",
            "options": { "symlink": true }
        }
    ],
    "require": {
        "php": "<8.5.0",
        "pes/pes-core": "@dev",
        "pes/pes-http": "@dev",
        "pes/pes-di": "@dev",
        "pes/pes-router": "@dev",
        "pes/pes-database": "@dev",
        "pes/pes-view": "@dev",
        "pes/pes-application": "@dev",
        "pes/pes-logger": "@dev",
        "pes/pes-session": "@dev",
        "pes/pes-bootstrap": "@dev",
        "psr/http-message": "^2.0",
        "psr/http-factory": "^1.0",
        "psr/container": "^2.0",
        "psr/log": "^3.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5",
        "friendsofphp/php-cs-fixer": "^3.93"
    },
    "autoload": {
        "psr-4": {
            "Pes\\Acl\\": "src/Acl/",
            "Pes\\Autoloader\\": "src/Autoloader/",
            "Pes\\Config\\": "src/Config/",
            "Pes\\Entity\\": "src/Entity/",
            "Pes\\Readers\\": "src/Readers/",
            "Pes\\Repository\\": "src/Repository/",
            "Pes\\Storage\\": "src/Storage/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pes\\Router\\": "pes-router/src/",
            "Pes\\Router\\Tests\\": "tests/pes-router/Router/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:core": "phpunit --testsuite pes-core",
        "test:database": "phpunit --testsuite pes-database",
        "test:di": "phpunit --testsuite pes-di",
        "test:logger": "phpunit --testsuite pes-logger",
        "test:router": "phpunit --testsuite pes-router",
        "test:view": "phpunit --testsuite pes-view",
        "test:root": "phpunit --testsuite pes-root"
    },
    "scripts-descriptions": {
        "test": "Spustí všechny PHPUnit testsuity (viz phpunit.xml.dist)",
        "test:core": "Spustí jen testy pro pes-core",
        "test:database": "Spustí jen testy pro pes-database",
        "test:di": "Spustí jen testy pro pes-di",
        "test:logger": "Spustí jen testy pro pes-logger",
        "test:router": "Spustí jen testy pro pes-router",
        "test:view": "Spustí jen testy pro pes-view",
        "test:root": "Spustí testy z kořenového balíčku (Autoloader apod.)"
    }
}
